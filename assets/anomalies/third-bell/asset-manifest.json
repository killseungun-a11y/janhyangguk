{
  "id": "third-bell",
  "name": "세 번째 벨",
  "canvas": {"width": 1024, "height": 1536},
  "format": "webp",
  "layering": "full-canvas",
  "assets": {
    "room_base": "room_base.webp",
    "phone_body": "phone_body.webp",
    "receiver": "receiver.webp",
    "cord_normal": "cord_normal.webp",
    "cord_tension": "cord_tension.webp",
    "indicator_light": "indicator_light.webp",
    "vibration_fx": "vibration_fx.webp",
    "shadow_normal": "shadow_normal.webp",
    "shadow_long": "shadow_long.webp"
  },
  "states": {
    "NORMAL": ["room_base", "shadow_normal", "phone_body", "receiver", "cord_normal"],
    "OMEN": ["room_base", "shadow_normal", "phone_body", "receiver", "cord_normal", "indicator_light", "vibration_fx"],
    "OMEN2": ["room_base", "shadow_normal", "phone_body", "receiver", "cord_tension", "indicator_light", "vibration_fx"],
    "UNSTABLE": ["room_base", "shadow_long", "phone_body", "receiver", "cord_tension", "indicator_light", "vibration_fx"],
    "MELTDOWN": ["room_base", "shadow_long", "phone_body", "receiver", "cord_tension", "indicator_light", "vibration_fx"]
  },
  "animation": {
    "phone_body": ["translateX", "translateY"],
    "receiver": ["translateX", "translateY", "rotate"],
    "indicator_light": ["opacity", "brightness"],
    "vibration_fx": ["opacity"],
    "room_base": ["brightness"],
    "shadow_long": ["opacity", "scale"]
  }
}
